[project]
sub_id = "8fdd6d14"
name = "car-wrap-cloud"
requires = ["nodejs-24"]
project_type = "web"
version = "0.1.9"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "./scripts/preview-build.sh"]
run = ["bash", "./scripts/dev.sh"]

[deploy]
build = ["bash", "./scripts/build.sh"]
run = ["bash", "./scripts/start.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = ["."]